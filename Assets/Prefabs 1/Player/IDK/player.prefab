--- !u!114 &8953736999617887435
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8499587821674565525}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The rain whispered against the window, as if trying to remind her of something
    she had promised long ago.\nHe carried the silence of the mountains within him,
    a stillness that unsettled everyone who met his gaze.\nIn the flickering candlelight,
    the old map seemed almost alive, its ink shifting like restless shadows.\nTime,
    she realized, was not a river but a tide\u2014always returning, always pulling
    her back to where it began.\nThe city slept beneath a veil of fog, dreaming of
    secrets it would never confess to the dawn.\n"
